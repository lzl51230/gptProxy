<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>ChatGPT Proxy</title>
    <options customize="never" require-scripts="false" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <allowed-os-versions>
        <os-version min="__MINIMUM_SYSTEM_VERSION__"/>
    </allowed-os-versions>
    <product id="local.alex.chatgpt-proxy.installer" version="__PRODUCT_VERSION__"/>
    <choices-outline>
        <line choice="default">
            <line choice="__LAUNCHER_IDENTIFIER__"/>
            <line choice="__PROXYBRIDGE_IDENTIFIER__"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="__LAUNCHER_IDENTIFIER__" visible="false">
        <pkg-ref id="__LAUNCHER_IDENTIFIER__"/>
    </choice>
    <choice id="__PROXYBRIDGE_IDENTIFIER__" visible="false">
        <pkg-ref id="__PROXYBRIDGE_IDENTIFIER__"/>
    </choice>
    <pkg-ref id="__LAUNCHER_IDENTIFIER__" version="__PRODUCT_VERSION__" onConclusion="none">#ChatGPT-Proxy-Launcher.pkg</pkg-ref>
    <pkg-ref id="__PROXYBRIDGE_IDENTIFIER__" version="__PROXYBRIDGE_VERSION__" onConclusion="none">#ProxyBridge.pkg</pkg-ref>
</installer-gui-script>
